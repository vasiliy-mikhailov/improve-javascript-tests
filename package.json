{
  "name": "improve-javascript-tests",
  "version": "1.0.0",
  "private": true,
  "description": "n8n pipeline in Docker that raises coverage, Stryker mutation score and MAC of any JS/TS repo",
  "scripts": {
    "test": "node --test sidecar/test/*.test.js n8n/test/*.test.js",
    "test:sidecar": "node --test sidecar/test/*.test.js",
    "test:n8n": "node --test n8n/test/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-coverage-exclude='**/test/**' --test-coverage-exclude='**/dashboard/**' --test-coverage-exclude='eval/**' --test-coverage-exclude='scripts/**' sidecar/test/*.test.js n8n/test/*.test.js",
    "coverage:check": "node --test --experimental-test-coverage --test-reporter=spec --test-coverage-exclude='**/test/**' --test-coverage-exclude='**/dashboard/**' --test-coverage-exclude='eval/**' --test-coverage-exclude='scripts/**' --test-coverage-lines=67 --test-coverage-branches=72 --test-coverage-functions=68 sidecar/test/*.test.js n8n/test/*.test.js",
    "workflow": "node n8n/generate-workflows.mjs",
    "check": "npm test && npm run coverage:check && node n8n/generate-workflows.mjs"
  },
  "license": "MIT"
}

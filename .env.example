# ─── GitHub ─────────────────────────────────────────────────────────────────
# PAT with repo scope: clone private repos, push branches, open PRs.
GH_TOKEN=ghp_replace_me
GIT_USER_NAME=Improve Tests Bot
GIT_USER_EMAIL=bot@example.com

# ─── Target repo (teams: change these two lines and run) ────────────────────
REPO_URL=https://github.com/your-org/your-js-repo
REPO_BRANCH=main

# ─── Scope & loop policy ────────────────────────────────────────────────────
# Comma-separated globs of source files eligible for improvement.
SCOPE_GLOB=src/**/*.{js,ts,jsx,tsx}
# 0 = whole repo; N = stop after N files were processed (improved or given up).
# Start with 1 for a smoke test, then set 0 for a full-repo run.
SCOPE_LIMIT=1
# 0 = no limit for the repo.
MAX_ITERATIONS=0
# Failure budget per file: how many attempts may FAIL before we move on.
# Successful kills are free — they are the goal, not the cost.
MAX_MUTANTS_PER_FILE=15
# Per-file improvement rounds: keep going until all of coverage/mutation/MAC stale or any degrades.
MAX_ROUNDS_PER_FILE=8
# Pick attempts per file before it is settled as no_improvement.
MAX_ATTEMPTS_PER_FILE=3
# github = push branch + open real PR | local = record branch + patch + PR payload
PR_MODE=github
# Base branch for PRs (defaults to REPO_BRANCH).
PR_BASE=
# npm script to run after install (e.g. "build" when tests need built artifacts).
SETUP_SCRIPT=
DRY_RUN=false

# ─── Team rules, applied at every stage (free text, LLM-interpreted) ───────
RULES_POST_CLONE=read AGENTS.md to find out how to behave after cloning
RULES_PRE_PICK=create a separate branch per file named tests/improve-{file}
RULES_PICK_FILE=pick the file with the weakest tests; UI components are fair game
RULES_WRITE_TEST=don't use introspection; follow the existing test style
RULES_CHECK_CHANGES=changes are good only if MAC improved and the suite is green
RULES_MAKE_PR=read AGENTS.md to find out how to make the PR properly

# ─── LLM (OpenAI-compatible /v1) ────────────────────────────────────────────
LLM_BASE_URL=https://inference.mikhailov.tech/qwen-3.6-27b-fp8/v1
LLM_API_KEY=sk-replace_me
LLM_MODEL=qwen-3.6-27b-fp8
LLM_CONTEXT_LENGTH=32768
LLM_ENABLE_THINKING=true

# ─── Mutation-run parallelism (CPU is cheap; model time is not) ─────────────
# Mutation is the loop's dominant wall-clock cost by design — it re-runs over the
# whole file after every attempt — so spare cores are the cheapest throughput
# available. But Stryker counts a TIMED-OUT mutant as KILLED: raising concurrency
# alone turns machine contention into free "improvement". Move the timeout with
# the parallelism, and watch for the timeout-share warning in the event log.
# These defaults assume a box with ~24 cores; scale both down together on smaller
# hardware.
STRYKER_CONCURRENCY=12
STRYKER_TIMEOUT_MS=120000
STRYKER_TIMEOUT_FACTOR=2.5
# auto = use the endpoint's JSON mode for structured replies (kills repair retries);
# off = always free-form + repair.
LLM_JSON_MODE=auto

# ─── Services ───────────────────────────────────────────────────────────────
SIDECAR_PORT=3000
N8N_PORT=5678
N8N_OWNER_EMAIL=admin@ijst.local
# WEBHOOK/editor URLs for links in n8n UI
WEBHOOK_URL=https://improve-javascript-tests.mikhailov.tech/
N8N_EDITOR_BASE_URL=https://improve-javascript-tests.mikhailov.tech/

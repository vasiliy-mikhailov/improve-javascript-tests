{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing for the pipeline's OWN code. node:test via the command runner. The dot reporter matters: Stryker stores a failing mutant's entire stdout as statusReason, and TAP output at 6k mutants exhausts the heap while writing the report.",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test --test-reporter=dot sidecar/test/*.test.js n8n/test/*.test.js"
  },
  "mutate": [
    "sidecar/*.js",
    "n8n/nodes/*.js",
    "n8n/node-id.js",
    "!sidecar/test/**",
    "!**/*.test.js"
  ],
  "reporters": [
    "json",
    "progress"
  ],
  "jsonReporter": {
    "fileName": "reports/self-mutation/mutation.json"
  },
  "coverageAnalysis": "off",
  "timeoutMS": 60000,
  "concurrency": 6,
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": null
  },
  "incremental": true,
  "incrementalFile": "reports/self-mutation/stryker-incremental.json"
}
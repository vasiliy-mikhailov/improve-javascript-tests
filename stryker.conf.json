{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing for the pipeline's OWN code. The suite is node:test, so the command runner is the honest choice: it runs `npm test` per mutant, and the whole suite takes under a second.",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm test"
  },
  "mutate": [
    "sidecar/*.js",
    "n8n/nodes/*.js",
    "n8n/node-id.js",
    "!sidecar/test/**",
    "!**/*.test.js"
  ],
  "reporters": [
    "html",
    "json",
    "progress"
  ],
  "jsonReporter": {
    "fileName": "reports/self-mutation/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/self-mutation/index.html"
  },
  "coverageAnalysis": "off",
  "timeoutMS": 60000,
  "concurrency": 6,
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": null
  },
  "incremental": true,
  "incrementalFile": "reports/self-mutation/stryker-incremental.json"
}